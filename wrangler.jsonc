{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vintage",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// URL de producción en workers.dev y URLs de preview por versión
	// (`wrangler versions upload --preview-alias pr-<N>`).
	"workers_dev": true,
	"preview_urls": true,
	// Variables no secretas con valores de desarrollo. En local se sobreescriben
	// con .env; en CI el despliegue las inyecta con `--var` desde las variables
	// del repo de GitHub.
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173",
		"WHATSAPP_NUMBER": "",
		"R2_PUBLIC_URL": "",
		// Login de desarrollo (ticket #3): "true" solo en local y en las vistas
		// previas. Vacío en producción: /ingresar/desarrollo responde 404.
		"DEV_LOGIN": ""
	},
	// Secretos de runtime. En local van en .env; en producción los sube el
	// CI con `wrangler deploy --secrets-file`. Wrangler rechaza el despliegue si
	// falta alguno.
	"secrets": {
		"required": [
			"DATABASE_URL",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"ADMIN_EMAILS"
		]
	},
	// Fotos de las piezas (tres variantes por foto, generadas en el navegador).
	// El CI verifica que coincida con la variable R2_BUCKET de GitHub.
	"r2_buckets": [
		{
			"binding": "FOTOS",
			"bucket_name": "vintage-fotos"
		}
	]
}
