{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vintage",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// URL de producción en workers.dev y URLs de preview por versión
	// (`wrangler versions upload --preview-alias pr-<N>`).
	"workers_dev": true,
	"preview_urls": true,
	// Variables no secretas. En local se sobreescriben con .dev.vars; en CI el
	// despliegue las inyecta con `--var` desde las variables del repo de GitHub.
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173",
		"WHATSAPP_NUMBER": "",
		"R2_PUBLIC_URL": ""
	},
	// Secretos de runtime. En local van en .dev.vars; en producción los sube el
	// CI con `wrangler deploy --secrets-file`. Wrangler rechaza el despliegue si
	// falta alguno.
	"secrets": {
		"required": [
			"DATABASE_URL",
			"BETTER_AUTH_SECRET",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"ADMIN_EMAILS"
		]
	},
	// Fotos de las piezas (tres variantes por foto, generadas en el navegador).
	"r2_buckets": [
		{
			"binding": "FOTOS",
			"bucket_name": "vintage-fotos"
		}
	]
}
