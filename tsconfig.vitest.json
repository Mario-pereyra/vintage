{
  "extends": "./tsconfig.json",
  "include": ["app/dominio/**/*", "app/generated/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
