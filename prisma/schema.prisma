// Esquema de la base de datos de Vintage.
// El vocabulario sigue CONTEXT.md. Las migraciones viven en prisma/migrations
// y son las mismas que usan las pruebas del dominio (PGlite) y producción (Neon).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

/// Etapa de una pieza en su ciclo de vida (ver "Estado de pieza" en CONTEXT.md).
enum EstadoPieza {
  EN_PREPARACION
  DISPONIBLE
  RESERVADA
  VENDIDA
  RETIRADA
}

/// Modalidad por la que se obtiene un lote (ver "Canal de abastecimiento" en
/// CONTEXT.md). Compra a particular no tiene lote (ver `Pieza.proveedorId`) y
/// consignación queda fuera de la Etapa 1 (spec, "Out of Scope").
enum CanalDeAbastecimiento {
  FARDO_CERRADO
  LOTE_CLASIFICADO
  LOTE_SELECCIONADO
}

/// Escala fija de condición de una pieza (ver "Condición" en CONTEXT.md). La
/// condición de ingreso y la condición con la que se publica (ticket #6) usan
/// esta misma escala.
enum Condicion {
  EXCELENTE
  MUY_BUENA
  BUENA
  CON_DETALLES
}

/// Grado de certeza sobre la marca de una pieza (ver "Autenticidad" en
/// CONTEXT.md, ADR 0002). Sin marca (`Pieza.marcaId` nulo) no hay autenticidad
/// que declarar: solo existe cuando hay una marca elegida. "Original" no es un
/// valor de este enum: es una consecuencia de `COMPROBADA` (#6).
enum Autenticidad {
  COMPROBADA
  ATRIBUIDA
}

/// Un artículo físico único del inventario, con los tres identificadores del
/// ADR 0006:
/// - `id`: UUID v7 interno, nunca visible;
/// - `codigo`: correlativo de la secuencia `pieza_codigo_seq`, que nunca se
///   reutiliza; se muestra con el prefijo de la marca (`VT-0001`);
/// - `sufijo`: aleatorio y corto; la URL pública es `/carteras/<slug>-<sufijo>`
///   y el slug se deriva del nombre, así que la URL sobrevive a un renombre.
///
/// Mientras está En preparación los datos pueden estar incompletos; publicar
/// exige los obligatorios. Procedencia y costo de reacondicionamiento llegan
/// con #8 (ver más abajo); condición, visibilidad, drop y retiro llegan con
/// sus tickets (#6, #9, #10, #12).
model Pieza {
  id     String @id @db.Uuid
  codigo Int    @unique @default(autoincrement())
  sufijo String @unique

  nombre     String?
  tipoId     Int?           @map("tipo_id")
  tipo       TipoDeCartera? @relation(fields: [tipoId], references: [id])
  colorId    Int?           @map("color_id")
  color      Color?         @relation(fields: [colorId], references: [id])
  materialId Int?           @map("material_id")
  material   Material?      @relation(fields: [materialId], references: [id])

  /// Medidas en cm, con la cartera cerrada y sin asas.
  altoCm        Float? @map("alto_cm")
  anchoCm       Float? @map("ancho_cm")
  profundidadCm Float? @map("profundidad_cm")
  /// Caída del asa o de la correa, en cm. Opcional: un clutch puede no tener.
  caidaCm       Float? @map("caida_cm")

  /// Precio publicado en bolivianos (BOB), en centavos enteros.
  precioCentavos Int? @map("precio_centavos")

  // --- Procedencia y costo (ticket #8, ADR 0001) ----------------------------
  // Toda pieza llega por un lote (con su reparto de costo) o por una compra a
  // particular (con costo directo): nunca por las dos vías. El dominio exige
  // una de las dos al abrir un lote o registrar una compra a particular; estos
  // campos quedan sueltos aquí para que `crearPieza`/`editarPieza` (#4) los
  // guarden como el resto de los datos. Nunca se publican.
  loteId                           Int?       @map("lote_id")
  lote                             Lote?      @relation(fields: [loteId], references: [id])
  /// Proveedor directo, solo cuando la pieza viene de una compra a particular
  /// (sin lote). Si viene de un lote, su proveedor es el del lote.
  proveedorId                      Int?       @map("proveedor_id")
  proveedor                        Proveedor? @relation(fields: [proveedorId], references: [id])
  /// Lo pagado por la pieza en una compra a particular, sin lote.
  costoDirectoCentavos             Int?       @map("costo_directo_centavos")
  /// Limpieza o reparación de esta pieza. Se suma al reparto del costo del
  /// lote (o al costo directo) para dar el costo de pieza.
  costoReacondicionamientoCentavos Int        @default(0) @map("costo_reacondicionamiento_centavos")
  /// Condición asignada en la apertura del lote (o, si es compra a
  /// particular, al registrarla). Puede diferir de la condición de
  /// publicación (#6).
  condicionIngreso                 Condicion? @map("condicion_ingreso")

  // --- Atributos opcionales y visibilidad por campo (ticket #6) -------------
  // Fotos, medidas y los datos de arriba (tipo, color, material, precio) se
  // publican siempre. Estos son opcionales: cada uno lleva su propio
  // interruptor `visible*`, salvo `descripcion`, que se publica siempre que
  // haya una (como el resto de los datos siempre visibles). Lo que la
  // operadora marca como no visible no llega a `fichaPublica`.
  /// Condición con la que se publica la pieza. Puede diferir de
  /// `condicionIngreso` (la de la apertura del lote o la compra a particular).
  condicion             Condicion? @map("condicion")
  visibleCondicion      Boolean    @default(true) @map("visible_condicion")
  /// Detalle breve y opcional de lo que la pieza conserva tras su preparación.
  notaCondicion         String?    @map("nota_condicion")
  visibleNotaCondicion  Boolean    @default(true) @map("visible_nota_condicion")
  /// Marca (lista ampliable) y autenticidad se publican juntas o ninguna: un
  /// solo interruptor (`visibleMarca`) cubre ambas (ADR 0002). Sin marca,
  /// `autenticidad` queda en `null`: no hay nada que autenticar.
  marcaId               Int?          @map("marca_id")
  marca                 Marca?        @relation(fields: [marcaId], references: [id])
  autenticidad          Autenticidad? @map("autenticidad")
  visibleMarca          Boolean       @default(true) @map("visible_marca")
  cierre                String?    @map("cierre")
  visibleCierre         Boolean    @default(true) @map("visible_cierre")
  /// Interior y sus compartimentos, en un solo campo de texto libre.
  interior              String?    @map("interior")
  visibleInterior       Boolean    @default(true) @map("visible_interior")
  colorHerrajes         String?    @map("color_herrajes")
  visibleHerrajes       Boolean    @default(true) @map("visible_herrajes")
  incluye               String?    @map("incluye")
  visibleIncluye        Boolean    @default(true) @map("visible_incluye")
  /// Qué objetos entran (celular, billetera, lentes…), en texto libre.
  queCabe               String?    @map("que_cabe")
  visibleQueCabe        Boolean    @default(true) @map("visible_que_cabe")
  /// Descripción libre de 2 a 4 frases. Siempre visible cuando existe: no
  /// tiene interruptor propio.
  descripcion           String?    @map("descripcion")

  estado        EstadoPieza @default(EN_PREPARACION)
  publicadaEn   DateTime?   @map("publicada_en")
  creadaEn      DateTime    @default(now()) @map("creada_en")
  actualizadaEn DateTime    @default(now()) @updatedAt @map("actualizada_en")

  reservas    Reserva[]
  interesadas Interesada[]
  fotos       Foto[]
  venta       Venta?
  retiro      Retiro?

  @@index([estado, publicadaEn])
  @@index([loteId])
  @@index([proveedorId])
  @@index([marcaId])
  @@map("pieza")
}

/// Las 8 tomas estandarizadas de una pieza (PRODUCT.md), en el orden en que se
/// muestran siempre en el panel y en la ficha pública.
enum TipoDeToma {
  FRENTE
  DORSO
  LATERAL
  BASE_Y_ESQUINAS
  INTERIOR
  HERRAJES_Y_CIERRE
  ASAS
  PUESTA
}

/// Una foto de una pieza, con sus tres variantes generadas en el navegador
/// (ADR 0005): miniatura (panel), catálogo (listado y Open Graph) y detalle
/// (ficha pública). Las claves son objetos del bucket R2 `vintage-fotos`; la
/// URL pública se arma con `R2_PUBLIC_URL` fuera del dominio.
///
/// Cada pieza tiene a lo sumo una foto por tipo de toma: volver a fotografiar
/// una toma reemplaza la anterior. Exactamente una foto es la portada, la que
/// usa el catálogo y el Open Graph.
model Foto {
  id      String     @id @db.Uuid
  piezaId String     @map("pieza_id") @db.Uuid
  pieza   Pieza      @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  tipo    TipoDeToma
  portada Boolean    @default(false)

  claveMiniatura String @map("clave_miniatura")
  claveCatalogo  String @map("clave_catalogo")
  claveDetalle   String @map("clave_detalle")

  creadaEn DateTime @default(now()) @map("creada_en")

  @@unique([piezaId, tipo])
  @@map("foto")
}

/// La persona o negocio a quien se le compra un lote o una pieza (ver
/// "Proveedor" en CONTEXT.md). Un particular que vende una sola cartera
/// también es proveedor.
model Proveedor {
  id       Int    @id @default(autoincrement())
  nombre   String
  contacto String

  lotes  Lote[]
  piezas Pieza[]

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("proveedor")
}

/// Denominación de mercado con la que el proveedor vende un lote (Primera,
/// Segunda…). Lista cerrada ampliable, con los mismos valores iniciales de
/// PRODUCT.md.
model CalidadDeclarada {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  lotes  Lote[]

  @@map("calidad_declarada")
}

/// Un conjunto de piezas adquiridas juntas a un proveedor en una sola compra
/// (ver "Lote" en CONTEXT.md). La apertura (`fechaApertura` en adelante) se
/// registra una sola vez y crea las piezas del lote; los descartes no generan
/// fila de pieza y por eso no reciben parte del costo.
model Lote {
  id Int @id @default(autoincrement())

  proveedorId Int                   @map("proveedor_id")
  proveedor   Proveedor             @relation(fields: [proveedorId], references: [id])
  canal       CanalDeAbastecimiento

  calidadDeclaradaId Int              @map("calidad_declarada_id")
  calidadDeclarada   CalidadDeclarada @relation(fields: [calidadDeclaradaId], references: [id])

  /// Precio pagado por el lote, sin transporte.
  costoCentavos      Int @map("costo_centavos")
  /// Transporte de esa compra. Junto al costo, se reparte entre las piezas.
  transporteCentavos Int @default(0) @map("transporte_centavos")

  fechaCompra    DateTime  @map("fecha_compra")
  fechaRecepcion DateTime? @map("fecha_recepcion")

  // --- Apertura: se llenan las cinco juntas, una sola vez ------------------
  fechaApertura     DateTime? @map("fecha_apertura")
  unidadesRecibidas Int?      @map("unidades_recibidas")
  descartes         Int?
  notaApertura      String?   @map("nota_apertura")

  piezas Pieza[]

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([proveedorId])
  @@map("lote")
}

// --- Listas cerradas que la operadora puede ampliar -------------------------
// Los valores iniciales se cargan en la migración; el orden de la lista es el
// de alta (`id`). Marca y calidad declarada llegan con #6 y #8.

/// Estilo de una cartera: de hombro, de mano, bandolera, tote, clutch…
model TipoDeCartera {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  piezas Pieza[]

  @@map("tipo_de_cartera")
}

model Color {
  id      Int     @id @default(autoincrement())
  nombre  String  @unique
  /// Color de muestra para el chip (`#16130f`). Es un dato, no una tinta.
  muestra String?
  piezas  Pieza[]

  @@map("color")
}

model Material {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  piezas Pieza[]

  @@map("material")
}

/// Marca de una pieza (ticket #6). Lista cerrada ampliable, igual que tipo,
/// color y material; su autenticidad se registra aparte en `Pieza`.
model Marca {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  piezas Pieza[]

  @@map("marca")
}

// --- Reservas (ticket #9, ADR 0003) ----------------------------------------

/// Dónde nació una reserva: define su plazo por defecto (15 min en un live,
/// 2 horas fuera de él).
enum OrigenDeReserva {
  LIVE
  FUERA_DE_LIVE
}

/// Una reserva está activa hasta que vence, se cancela o se paga (PAGADA: el
/// pago verificado la convirtió en venta, ticket #10).
enum EstadoReserva {
  ACTIVA
  VENCIDA
  CANCELADA
  PAGADA
}

/// La persona que compra por WhatsApp. Su número es único (solo dígitos, con
/// código de país). El contador de reservas vencidas no se guarda: se cuenta
/// a partir de sus reservas, y es interno (nunca se publica).
model Compradora {
  id       String    @id @db.Uuid
  nombre   String
  whatsapp String    @unique
  creadaEn DateTime  @default(now()) @map("creada_en")
  reservas Reserva[]
  ventas   Venta[]

  @@map("compradora")
}

/// El apartado temporal de una pieza para una compradora (ver "Reserva" en
/// CONTEXT.md). Una pieza tiene como máximo una reserva ACTIVA: lo garantiza
/// el paso de la pieza de Disponible a Reservada dentro de la misma
/// transacción que crea la reserva.
///
/// El vencimiento es perezoso: una reserva ACTIVA con `venceEn` en el pasado
/// ya está vencida, y el dominio la marca VENCIDA (y devuelve la pieza a
/// Disponible) antes de leer u operar sobre piezas o reservas.
model Reserva {
  id            String          @id @db.Uuid
  piezaId       String          @map("pieza_id") @db.Uuid
  pieza         Pieza           @relation(fields: [piezaId], references: [id])
  compradoraId  String          @map("compradora_id") @db.Uuid
  compradora    Compradora      @relation(fields: [compradoraId], references: [id])
  origen        OrigenDeReserva
  estado        EstadoReserva   @default(ACTIVA)
  /// La compradora ya tenía 2 reservas vencidas: se reservó con pago previo.
  conPagoPrevio Boolean         @default(false) @map("con_pago_previo")
  creadaEn      DateTime        @map("creada_en")
  venceEn       DateTime        @map("vence_en")
  canceladaEn   DateTime?       @map("cancelada_en")
  venta         Venta?

  @@index([estado, venceEn])
  @@index([piezaId, estado])
  @@index([compradoraId, estado])
  @@map("reserva")
}

/// Alguien que mostró interés en una pieza sin reservarla, para contactarla a
/// mano si la pieza vuelve a estar Disponible. No es una lista de espera.
model Interesada {
  id       String   @id @db.Uuid
  piezaId  String   @map("pieza_id") @db.Uuid
  pieza    Pieza    @relation(fields: [piezaId], references: [id])
  nombre   String
  whatsapp String
  nota     String?
  creadaEn DateTime @map("creada_en")

  @@index([piezaId])
  @@map("interesada")
}

// --- Ventas, entregas y retiros (ticket #10) --------------------------------

/// La red o vía por la que llegó la compradora (ver "Canal de captación").
enum CanalDeCaptacion {
  TIKTOK_PUBLICACION
  TIKTOK_LIVE
  INSTAGRAM_PUBLICACION
  INSTAGRAM_LIVE
  FACEBOOK_PUBLICACION
  FACEBOOK_LIVE
  WEB
  RECOMENDACION
}

/// Cómo llega la pieza vendida a la compradora (ver "Modalidad de entrega").
enum ModalidadDeEntrega {
  RETIRO
  DELIVERY_SANTA_CRUZ
  ENVIO_DEPARTAMENTO
}

enum EstadoEntrega {
  PENDIENTE
  ENTREGADA
}

/// El cierre de una pieza con una compradora, con pago verificado. Una pieza
/// tiene como máximo una venta (Vendida es un estado final). Si nació de una
/// reserva, `reservaId` la enlaza (la reserva pasa a PAGADA).
///
/// La entrega vive en la misma fila (una venta, una entrega). Los montos van
/// en centavos de boliviano. La rentabilidad (#11) suma `precioFinalCentavos`
/// y `costoEntregaCentavos` por `vendidaEn`.
model Venta {
  id                   String             @id @db.Uuid
  piezaId              String             @unique @map("pieza_id") @db.Uuid
  pieza                Pieza              @relation(fields: [piezaId], references: [id])
  compradoraId         String             @map("compradora_id") @db.Uuid
  compradora           Compradora         @relation(fields: [compradoraId], references: [id])
  reservaId            String?            @unique @map("reserva_id") @db.Uuid
  reserva              Reserva?           @relation(fields: [reservaId], references: [id])
  /// Puede ser menor que el precio publicado (regateo por WhatsApp).
  precioFinalCentavos  Int                @map("precio_final_centavos")
  /// La fecha de la venta. Puede ser anterior al registro (`creadaEn`).
  vendidaEn            DateTime           @map("vendida_en")
  canal                CanalDeCaptacion
  /// Cuándo la operadora registró el pago verificado en el banco.
  pagoVerificadoEn     DateTime           @map("pago_verificado_en")
  modalidadDeEntrega   ModalidadDeEntrega @map("modalidad_de_entrega")
  costoEntregaCentavos Int                @map("costo_entrega_centavos")
  estadoDeEntrega      EstadoEntrega      @default(PENDIENTE) @map("estado_de_entrega")
  /// Guía o comprobante de un envío a otro departamento.
  guia                 String?
  entregadaEn          DateTime?          @map("entregada_en")
  creadaEn             DateTime           @map("creada_en")

  @@index([estadoDeEntrega, vendidaEn])
  @@index([vendidaEn])
  @@index([compradoraId])
  @@map("venta")
}

/// Por qué una pieza salió del catálogo sin venderse.
enum MotivoDeRetiro {
  IRRECUPERABLE
  DEVUELTA_AL_PROVEEDOR
  USO_PROPIO
  OTRO
}

/// El retiro de una pieza En preparación o Disponible. Retirada es un estado
/// final. La nota es obligatoria con el motivo OTRO.
model Retiro {
  id         String         @id @db.Uuid
  piezaId    String         @unique @map("pieza_id") @db.Uuid
  pieza      Pieza          @relation(fields: [piezaId], references: [id])
  motivo     MotivoDeRetiro
  nota       String?
  retiradaEn DateTime       @map("retirada_en")

  @@map("retiro")
}

// --- Sesiones de las operadoras (Better Auth) ------------------------------
// Tablas que exige Better Auth, con sus nombres de campo. Un `User` es una
// operadora que entró al panel: solo se crea si su correo está en la lista
// permitida (ADMIN_EMAILS). Ver app/servidor/autenticacion.server.ts.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("auth_user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verification")
}
