# Variables de entorno de Vintage.
#
# Local: copia este archivo a `.env` y completa los valores. El mismo `.env` lo
# leen Prisma (migraciones), Wrangler (CLI) y el dev server (runtime del Worker).
# Si creas un `.dev.vars`, Wrangler usa ese archivo en lugar de `.env` para el
# runtime local; no hace falta.
#
# Producción: los secretos viven en GitHub (Settings → Secrets) y el CI los sube
# al Worker; las variables no secretas viven en GitHub (Settings → Variables) y
# el CI las inyecta con `--var`. Ver README.md y .github/workflows/ci.yml.
#
# Nunca subas valores reales al repo.

# --- Base de datos (Neon, São Paulo) ---------------------------------------
# Conexión con pooling (host con "-pooler"). La usa la app en runtime.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-XXXX-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexión directa, sin pooling. La usa `prisma migrate` (local y CI).
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-XXXX.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Login de operadoras (Better Auth + Google) — ticket #3 ------------------
# Secreto aleatorio largo, p. ej. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# URL pública de la app. En local, el dev server corre siempre en este puerto
# (es la URL registrada en Google OAuth).
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Correos con acceso al panel /admin, separados por coma.
ADMIN_EMAILS="operadora1@gmail.com,operadora2@gmail.com"

# --- Catálogo público --------------------------------------------------------
# Número para el botón de WhatsApp, formato wa.me: solo dígitos, con código de
# país y sin "+" (p. ej. 5917XXXXXXX).
WHATSAPP_NUMBER=""

# --- Fotos (Cloudflare R2, bucket vintage-fotos) ----------------------------
# URL pública del bucket (dominio r2.dev o propio), sin barra final.
R2_PUBLIC_URL=""

# --- Cloudflare (CLI de Wrangler) --------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
# Opcional en local (alternativa a `npx wrangler login`). En CI es un secreto
# de GitHub con permiso de edición de Workers y R2.
# CLOUDFLARE_API_TOKEN=""

# --- Solo en GitHub (Settings → Variables), no hacen falta en local ----------
# APP_URL: URL pública de producción, p. ej. https://vintage.<subdominio>.workers.dev
#   El CI la usa como BETTER_AUTH_URL del Worker (y deriva la de cada preview).
# R2_BUCKET: vintage-fotos (debe coincidir con r2_buckets en wrangler.jsonc).
